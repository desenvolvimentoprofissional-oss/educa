    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sanitize-html": "^2.17.7",
    "vite": "^6.2.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
